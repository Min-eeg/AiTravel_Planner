# Docker Compose 构建参数（复制为 .env 后填写，.env 已被 gitignore）
#
# 注意：compose 只读「项目根目录」的 .env 来填充 build args，
# 不会读取 frontend/.env 或 backend/.env —— 那两个是各自应用运行时用的。

# 高德 JS API Key（浏览器端）。vite 在构建时把它内联进产物，
# 所以必须在「构建」阶段传入，运行时再给环境变量是无效的。
VITE_AMAP_WEB_KEY=

# 国内构建加速（可选，不填则走官方源）
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
