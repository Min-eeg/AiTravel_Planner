# 途策智游 · 统一环境变量配置
#
# 复制为项目根目录的 .env 即可（.env 已被 gitignore，不会提交）：
#   cp .env.example .env
#
# 这份文件同时被三处读取：
#   1. 后端（app/core/config.py）
#   2. 前端（vite.config.ts 的 envDir 指向根目录）
#   3. docker compose（env_file + build args）
# 因此不需要在 backend/ 或 frontend/ 下再放一份。

# ===== LLM（OpenAI 兼容接口，如通义千问 / DeepSeek / OpenAI）=====
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen-plus
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ===== 高德地图 Web 服务 API（服务端用：POI 搜索 / 地理编码）=====
AMAP_API_KEY=your-amap-key-here

# ===== 天气数据源 =====
# open-meteo：免费、无需 Key、按经纬度查询（推荐，精度高于城市级）
# amap：需账号开通天气权限，否则返回 10002
WEATHER_PROVIDER=open-meteo

# ===== MCP（Model Context Protocol：POI 检索的首选链路）=====
# 置 0 关闭 MCP 链路，POI 检索直接走 REST（容器内默认 0：镜像里没有 uvx）
MCP_ENABLED=1
# MCP server 启动命令（JSON 数组字符串）
# 固定 pydantic<2.12：uvx 解析出的 mcp 1.8.x 仍引用 pydantic 2.12 起已移除的
# 内部符号 eval_type_backport，不约束会导致 server 启动即 ImportError 并静默降级 REST
MCP_SERVER_COMMAND=["uvx","--from","amap-mcp-server","--with","pydantic<2.12","amap-mcp-server"]
# 用于 POI 检索的 MCP 工具名
MCP_POI_TOOL=maps_text_search

# ===== 功能开关 =====
# RAG_ENABLED=0 关闭知识库注入，用于 A/B 对比
RAG_ENABLED=1
# 无 Key 时用 mock 数据跑通全链路，便于本地开发与 CI
MOCK_MODE=0
# 缓存 TTL（秒）
CACHE_TTL=3600

# ===== 前端（VITE_ 前缀会打构建进产物，禁止填任何密钥）=====
# 后端 API 地址。留空则走 vite.config.ts 的开发代理（推荐本地开发）
VITE_API_BASE_URL=
# 高德 JS API Key（浏览器端，路线图底图）。留空时仅路线图提示未配置
VITE_AMAP_WEB_KEY=
# 应用标题
VITE_APP_TITLE=途策智游

# ===== Docker Compose 构建加速（可选）=====
# 只在「构建镜像」时生效，不填则走官方源，不影响他人 clone 后构建
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
